{
  "name": "synomilo",
  "private": true,
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm --prefix apps/web run dev -- --port 3000",
    "dev:platform": "npm --prefix apps/platform run dev -- --port 3001",
    "build": "npm run build:web && npm run build:platform",
    "build:web": "npm --prefix apps/web run build",
    "build:platform": "npm --prefix apps/platform run build",
    "test": "node --test scripts/*.test.mjs",
    "typecheck": "npm --prefix apps/web run typecheck && npm --prefix apps/platform run typecheck"
  }
}
